# Datenbank (wird von docker compose gelesen)
POSTGRES_USER=bookcircle
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bookcircle
POSTGRES_PORT=5432

# Verbindung des lokal laufenden Backends (wird automatisch aus dieser Datei geladen).
# Passwort wie oben, nur Buchstaben und Zahlen. Bei geändertem POSTGRES_PORT den Port anpassen.
DATABASE_URL=postgresql+psycopg://bookcircle:change_me@localhost:5432/bookcircle